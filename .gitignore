# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# env files — never commit secrets (aplica a cualquier profundidad; .env.example sí sube)
.env*
!.env.example

# dependencies — SIN barra inicial: aplica a cualquier profundidad (monorepo)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
test-results/
playwright-report/

# next.js
.next/
out/

# build outputs (apps/api: tsc → dist/)
dist/
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# atl cache
.atl/.skill-registry.cache.json

# data — leads reales del negocio, nunca suben al repo (tests usan fixture sintético)
docs/*.csv
