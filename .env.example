# leadscore — plantilla de variables de entorno (U1)
# Copia este archivo como `.env` (gitignored en la raíz) y rellena valores reales.
# Nombres alineados con docs/SPEC.md §11; el workspace indicado es el consumidor.
# IMPORTANTE: los valores de abajo son ejemplos, no secretos reales.

# ============================ apps/api ============================

# Postgres vanilla self-hosted (necesaria desde U2).
# También la usan las migraciones de db/migrations para aplicar 0001_init.sql.
# Ejemplo: postgres://user:pass@localhost:5432/leadscore
DATABASE_URL=

# Secreto de firma de la cookie de sesión `__Host-ls_session` (HttpOnly) — mínimo 32 bytes aleatorios. [U3]
SESSION_SECRET=

# Cuenta única del MVP: seed de 1 tenant + 1 usuario en U3. [U3]
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Allowlist de orígenes con credenciales (nunca `*` junto a credentials: true). [U3]
# Dev: apps/web en local. Ejemplo: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Rate limit fijo por IP para POST /api/classify (público): 10 peticiones
# por ventana de 60000 ms → la 11ª responde 429. [U9]
CLASSIFY_RATE_LIMIT=10
CLASSIFY_RATE_WINDOW=60000

# ============================ apps/web ============================

# URL base de apps/api vista desde el navegador.
# Dev: http://localhost:8080 (puerto de Fastify); prod: mismo origen (Caddy enruta `/api/*`). [U7]
NEXT_PUBLIC_API_URL=http://localhost:8080

# ======================== comunes (ambos apps) ====================

# development | production (prod: cookies Secure; CORS solo en dev — prod es single-origin).
NODE_ENV=development

# Puerto del servidor Fastify en apps/api (dev: 8080, coherente con NEXT_PUBLIC_API_URL).
API_PORT=8080

# UUID del tenant `demo` reservado (SPEC §4/§6): alimenta /demo y /api/classify
# sin sesión y sin datos reales. Literal fijo = id del seed en db/migrations/0001_init.sql. [U2]
DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
